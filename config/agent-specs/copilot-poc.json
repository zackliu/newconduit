{
  "agentSpecId": "copilot-poc",
  "labels": {
    "agent": "copilot",
    "tier": "poc"
  },
  "launch": {
    "command": "copilot",
    "args": []
  },
  "instructions": "Complete the user's coding task, verify the result, and report the outcome.",
  "toolProfile": "copilot-poc-tools",
  "delegateRefs": {
    "asCaller": ["copilot-foundry"],
    "asCallee": []
  },
  "workerSelector": {
    "matchLabels": {
      "agent": "copilot",
      "storage": "volume-snapshot"
    }
  },
  "pausePolicy": "turn-boundary-durable-pause",
  "recoveryPolicy": "restart-with-context",
  "idlePauseTimeoutMs": 120000,
  "version": "poc-v1"
}
