{
  "agentSpecId": "copilot-foundry",
  "labels": {
    "agent": "copilot",
    "tier": "foundry"
  },
  "launch": {
    "command": "copilot",
    "args": []
  },
  "instructions": "Complete the user's task using the available workspace and tools.",
  "toolProfile": "copilot-poc-tools",
  "delegateRefs": {
    "asCaller": [],
    "asCallee": ["copilot-foundry"]
  },
  "workerSelector": {
    "matchLabels": {
      "agent": "copilot",
      "storage": "host-managed"
    }
  },
  "pausePolicy": "stop-on-pause",
  "recoveryPolicy": "restart-with-context",
  "idlePauseTimeoutMs": 120000,
  "version": "poc-v1"
}
